# SAAS Company — docker build context (Session 17 F4)
#
# The image needs ONLY: package.json, package-lock.json, prisma/, src/,
# public/, next.config.ts, tsconfig.json, postcss.config.mjs,
# components.json, eslint.config.mjs. Everything else is local state,
# reference material, or documentation.

# --- local state (never enters the image) ---
node_modules
.next
db/*.db
dev.log
server.log
.git
.gitignore
.env
.env.local
tests/.auth

# --- reference material, not runtime dependencies (AGENTS.md: the skills/
#     folder is excluded from every toolchain — including this one) ---
skills
docs/screenshots

# --- test + survey artifacts (the image ships no test runner entry) ---
tests
scripts
playwright.config.ts
vitest.config.ts

# --- documentation ---
docs
*.md
!README.md

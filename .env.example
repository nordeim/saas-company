# SAAS Company — environment configuration
# Copy to .env and adjust. SQLite keeps the zero-config local story:
#   npm run db:push && npm run db:seed
# The `db/` folder lives at the repo root (git-ignored).

# ---- Database -------------------------------------------------------------
# SQLite by default (zero-config local dev). A RELATIVE `file:` URL is
# resolved against prisma/schema.prisma — exactly like the Prisma CLI — so
# `file:../db/custom.db` points at <repo>/db/custom.db for the CLI
# (db push/seed) AND for the running server alike, regardless of the process
# working directory (src/lib/db-path.ts implements this resolution;
# tests/db-path.test.ts pins the contract).
# For production, an ABSOLUTE path is still recommended — see
# docs/DEPLOYMENT.md §4.
DATABASE_URL="file:../db/custom.db"

# ---- Site ------------------------------------------------------------------
# Canonical public origin — used for metadata, sitemap.xml, and robots.txt.
# Set to the deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Session signing secret for HMAC cookie auth.
# REQUIRED in production: generate with `openssl rand -hex 32`.
# Falls back to an insecure dev-only constant when unset.
AUTH_SECRET=""

# ---- Security tuning (optional) -------------------------------------------
# Auth-endpoint attempts allowed per IP per 15-minute window (login +
# register share one bucket). Default: 10. Raise behind shared egress
# IPs; the Playwright e2e webServer sets 50 (the suite's own UI sign-ins
# share one IP and one process with the in-memory limiter).
AUTH_RATE_LIMIT_MAX=10
